#Backup Example
# =========================
# ROCARE Backend Environment
# Phase 2 (.env.example)
# =========================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/rocare?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/rocare?sslmode=require

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ROCARE <noreply@rocare.in>"

SMS_PROVIDER=mock
SMS_API_KEY=demo_key
SMS_SENDER_ID=ROCARE

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_REQUESTS=3
OTP_WINDOW_SECONDS=60

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=rocare

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

LEAD_ACCEPTANCE_CHARGE=50
MIN_WALLET_BALANCE=300
VENDOR_COMMISSION_PERCENT=10

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
