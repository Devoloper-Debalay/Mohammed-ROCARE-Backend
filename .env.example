# TWILIO_FROM_PHONE=+1xxxxxxxxxx

# Vendor JWT configuration
JWT_VENDOR_SECRET_KEY=replace_with_a_long_random_access_secret
JWT_VENDOR_REFRESH_SECRET_KEY=replace_with_a_different_long_random_refresh_secret
JWT_VENDOR_ACCESS_EXPIRES_IN=1h
JWT_VENDOR_REFRESH_EXPIRES_IN=30d
JWT_VENDOR_ISSUER=vendor-auth
JWT_VENDOR_AUDIENCE=vendor-api

# Dedicated admin JWT signing secret. Keep this different from customer/vendor JWT secrets.
JWT_ADMIN_SECRET_KEY=replace-with-a-64-byte-random-secret
JWT_ADMIN_ACCESS_EXPIRES_IN=1d

# First Super Admin bootstrap (use only while running the bootstrap script; do not commit these values)
SUPER_ADMIN_EMAIL=admin@rocare.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
