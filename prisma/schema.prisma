generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ─────────────────────────────
 * ENUMS
 * ──────────────────────────────
 */
enum Role {
  CLIENT // Sign-up user / customer
  VENDOR // Agent / vendor / technician
  ADMIN
  SADMIN // Super admin
}

enum UserRank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum MlmCommissionType {
  DIRECT_BONUS
  LEVEL_BONUS
  BINARY_MATCHING
  LEADERSHIP_BONUS
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum CategoryType {
  PRODUCT
  SERVICE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_MENTIONED
}

enum Languages {
  BENGALI
  ENGLISH
  HINDI
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET_PASSWORD
}

enum ProductCategory {
  RO
  AC
  GEYSER
  OTHER
}

enum ServiceCategory {
  RO
  AC
  GEYSER
  OTHER
}

enum LeadSource {
  MR // Assigned to a specific MR (marketing rep)
  ALL // Open / all leads
  ADDED_BY_MC // Added by MC (RO, AC, Geyser, Service)
  PRODUCT_INQUIRY // Raised via product inquiry
  PRE_BOOKING
}

enum LeadStatus {
  NEW // just captured, not yet actioned by vendor/agent
  ACCEPTED // vendor/agent has accepted the lead (coins deducted)
  PENDING_START_VERIFICATION // technician submitted start-work proof, awaiting admin
  ONGOING // admin verified start proof; work in progress
  PENDING_DENIAL_VERIFICATION // technician submitted denial proof, awaiting admin
  COMPLETED
  DENIED
}

/**
 * ─────────────────────────────
 * VENDOR MODULE ENUMS (Phase 1)
 * ──────────────────────────────
 */
enum VendorRole {
  AGENT
  TECHNICIAN
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VendorProfileStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  BLOCKED
  DELETED
}

enum WalletTxnType {
  RECHARGE
  LEAD_ACCEPT
  LEAD_REFUND
  PRODUCT_PURCHASE
  PART_PURCHASE
  COMMISSION_CREDIT
  ADMIN_CREDIT
  ADMIN_DEBIT
  WITHDRAWAL
  BONUS
  OFFER_REWARD
}

enum WalletTxnStatus {
  SUCCESS
  PENDING
  FAILED
}

enum CommissionStatus {
  PENDING
  CREDITED
  REVERSED
}

enum VendorComplaintCategory {
  WALLET
  LEAD
  PAYMENT
  PRODUCT
  TECHNICAL_ISSUE
  OTHER
}

enum VendorComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OfferType {
  COUPON
  VOUCHER
  CASHBACK
  PRODUCT_DISCOUNT
}

enum OrderType {
  PRODUCT
  SERVICE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  DISPATCHED
  COMPLETED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  RAZORPAY
  STRIPE
}

enum ServiceRequestStatus {
  REQUESTED
  NEW
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  ONGOING
  COMPLETED
  DENIED
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum SiteFeedbackType {
  BUG
  SUGGESTION
  COMPLAINT
  GENERAL
}

enum SiteFeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ChatType {
  DIRECT
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  VOICE
  SYSTEM
}

/**
 * ─────────────────────────────
 * USER MODEL
 * ──────────────────────────────
 */
model User {
  id           String    @id @default(uuid())
  googleId     String?   @unique
  firstName    String
  middleName   String?   @default("")
  lastName     String
  dob          DateTime?
  email        String    @unique
  phone        String?   @unique
  password     String
  homeTown     String?   @default("Not mentioned yet.")
  currentCity  String?   @default("Not mentioned yet.")
  gender       Gender    @default(NOT_MENTIONED)
  role         Role      @default(CLIENT)
  isActive     Boolean   @default(true)
  createdBy    String?   @default("")
  updatedBy    String?   @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  profilePhoto String?   @default("")

  // Vendor/Agent specific profile (only populated when role = VENDOR)
  vendorProfile  VendorProfile?
  adminProfile   AdminProfile? //Admin Profile
  customerProfile Customer?

  // MLM & Referral fields
  rank           UserRank         @default(BRONZE) @map("user_rank")
  pv             Decimal          @default(0) @db.Decimal(12, 2)
  bv             Decimal          @default(0) @db.Decimal(12, 2)
  leftBv         Decimal          @default(0) @db.Decimal(12, 2)
  rightBv        Decimal          @default(0) @db.Decimal(12, 2)
  totalEarnings  Decimal          @default(0) @db.Decimal(12, 2)
  referralCode   String?          @unique
  sponsorId      String?
  sponsor        User?            @relation("UserReferrals", fields: [sponsorId], references: [id])
  referrals      User[]           @relation("UserReferrals")
  mlmCommissions MlmCommission[]  @relation("UserMlmCommissions")
  withdrawals    WithdrawalRequest[] @relation("UserWithdrawals")
  productReviews ProductReview[]  @relation("UserProductReviews")

  // Relations
  leadsAssigned   Lead[]           @relation("LeadAssignedTo")
  leadsCreated    Lead[]           @relation("LeadCreatedBy")
  orders          Order[]          @relation("OrderCustomer")
  carts           Cart[]            @relation("UserCarts")
  serviceRequests ServiceRequest[] @relation("ServiceRequestCustomer")
  complaints      Complaint[]      @relation("UserComplaints")
  notifications   Notification[]   @relation("UserNotifications")
  siteFeedbacks   SiteFeedback[]   @relation("UserSiteFeedbacks")
  chatRooms       ChatRoomMember[] @relation("UserChatRooms")
  messages        Message[]        @relation("UserMessages")
  messageReads    MessageRead[]    @relation("UserMessageReads")
  activityLogs    ActivityLog[]
  chatbotSessions ChatbotSession[]
}

/**
 * ─────────────────────────────
 * ADMIN ORGANISATION / BRANCH SCOPE
 * ──────────────────────────────
 */
model Branch {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  city      String
  state     String
  pincode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins          AdminProfile[]
  vendors         Vendor[]
  products        Product[]
  services        Service[]
  leads           Lead[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  inventory       Inventory[]
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  branchId  String?
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])
}

/**
 * ─────────────────────────────
 * VENDOR / AGENT PROFILE
 * ──────────────────────────────
 */
model VendorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  businessName   String?
  designation    String? // e.g. Agent, MR, ABC
  isVerified     Boolean  @default(false)
  currentLat     Float?
  currentLng     Float?
  serviceAddress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankDetails     VendorBank[]
  productsAdded   Product[]        @relation("VendorAddedProducts")
  servicesHandled ServiceRequest[] @relation("VendorServiceRequests")
  ordersHandled   Order[]          @relation("VendorOrders")
}

/**
 * ─────────────────────────────
 * VENDOR BANKING
 * ──────────────────────────────
 */
model VendorBank {
  id              String   @id @default(uuid())
  vendorProfileId String
  accountHolder   String
  accountNumber   String
  ifsc            String
  bankName        String
  upiId           String?
  isPrimary       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
}

/**
 * ─────────────────────────────
 * VENDOR (standalone, Phase 1)
 * Independent from `User` — vendor auth, KYC, wallet and lead work all
 * hang off this entity per the vendor-first platform requirements.
 * The older `User.role = VENDOR` / `VendorProfile` pair above is kept
 * for backward compatibility but is no longer the vendor auth path.
 * ──────────────────────────────
 */
model Vendor {
  id                 String                   @id @default(uuid())
  vendorCode         String                   @unique
  role               VendorRole
  fullName           String
  phone              String                   @unique
  phoneVerified      Boolean                  @default(false)
  email              String?                  @unique
  password           String
  profilePhoto       String?
  address            String?
  city               String?
  district           String?
  state              String?
  pincode            String?
  latitude           Float?
  longitude          Float?
  experienceYears    Int?
  skills             String[]                 @default([])
  specialization     String?
  verificationStatus VendorVerificationStatus @default(PENDING)
  profileStatus      VendorProfileStatus      @default(DRAFT)
  rejectionReason    String?

  // Referral & MLM fields
  referralCode       String?          @unique
  referredByVendorId String?
  rank               UserRank         @default(BRONZE) @map("vendor_rank")
  pv                 Decimal          @default(0) @db.Decimal(12, 2)
  bv                 Decimal          @default(0) @db.Decimal(12, 2)
  leftBv             Decimal          @default(0) @db.Decimal(12, 2)
  rightBv            Decimal          @default(0) @db.Decimal(12, 2)
  totalEarnings      Decimal          @default(0) @db.Decimal(12, 2)
  binaryPosition     String?          // "LEFT" | "RIGHT"

  // Soft-delete request flow: vendor requests -> admin approves -> deletedAt set.
  deletionRequested Boolean   @default(false)
  deletionReason    String?
  deletedAt         DateTime?
  branchId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referredBy Vendor?  @relation("VendorReferrals", fields: [referredByVendorId], references: [id])
  referrals  Vendor[] @relation("VendorReferrals")

  kyc        VendorKYC?
  bankDetail VendorBankDetail?
  wallet     Wallet?

  leadAssignments LeadAssignment[]
  visitProofs     LeadVisitProof[]
  denialProofs    LeadDenialProof[]
  progressLogs    LeadProgress[]
  commissions     Commission[]
  mlmCommissions  MlmCommission[]   @relation("VendorMlmCommissions")
  withdrawals     WithdrawalRequest[] @relation("VendorWithdrawals")
  complaints      VendorComplaint[]
  walletIssues    WalletIssue[]
  notifications   Notification[]    @relation("VendorNotifications")
  offerRewards    OfferReward[]
  payments        Payment[]
  reviews         Review[]

  assignedLeads   Lead[]           @relation("LeadAssignments")
  serviceRequests ServiceRequest[] @relation("ServiceRequestAssignedVendor")
  assignedOrders  Order[]          @relation("OrderAssignedVendor")
  locations       VendorLocation[]
  chatRooms       ChatRoomMember[]  @relation("VendorChatRooms")
  sentMessages    Message[]         @relation("VendorMessages")
  branch          Branch?          @relation(fields: [branchId], references: [id])
}

model VendorKYC {
  id                String   @id @default(uuid())
  vendorId          String   @unique
  aadhaarNumber     String?
  aadhaarFrontImage String?
  aadhaarBackImage  String?
  panNumber         String?
  panImage          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorBankDetail {
  id          String   @id @default(uuid())
  vendorId    String   @unique
  bankAccount String
  ifsc        String
  upiId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorOtp {
  id         String     @id @default(cuid())
  identifier String // phone or email
  code       String
  purpose    OtpPurpose
  expiresAt  DateTime
  used       Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([identifier])
}

/**
 * ─────────────────────────────
 * WALLET
 * ──────────────────────────────
 */
model VendorLocation {
  id         String   @id @default(uuid())
  vendorId   String
  latitude   Float
  longitude  Float
  accuracy   Float?
  capturedAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, capturedAt])
}

model Wallet {
  id            String   @id @default(uuid())
  vendorId      String   @unique
  balance       Decimal  @default(0) @db.Decimal(12, 2) // 1 coin = ₹1
  lockedBalance Decimal  @default(0) @db.Decimal(12, 2)
  totalEarned   Decimal  @default(0) @db.Decimal(12, 2)
  totalSpent    Decimal  @default(0) @db.Decimal(12, 2)
  totalRecharge Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String          @id @default(uuid())
  walletId     String
  type         WalletTxnType
  status       WalletTxnStatus @default(PENDING)
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal?        @db.Decimal(12, 2)
  referenceId  String? // leadId, orderId, paymentId, etc.
  note         String?
  createdAt    DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

/**
 * ─────────────────────────────
 * REVIEWS / RATINGS
 * Client rates a technician after a completed lead. 10+ ratings of 1-2
 * stars trips an automatic temporary restriction (see Vendor.profileStatus
 * = BLOCKED) until the vendor's local admin clears it.
 * ──────────────────────────────
 */
model Review {
  id        String   @id @default(uuid())
  leadId    String   @unique // one review per completed lead
  vendorId  String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId, rating])
}

/**
 * ─────────────────────────────
 * DYNAMIC CATEGORY
 * ──────────────────────────────
 */
model Category {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  icon        String?
  image       String?
  description String?
  type        CategoryType @default(PRODUCT)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products Product[] @relation("ProductCategoryRelation")
  services Service[] @relation("ServiceCategoryRelation")
}

/**
 * ─────────────────────────────
 * PRODUCT CATALOG
 * ──────────────────────────────
 */
model Product {
  branchId                String?
  id                      String           @id @default(uuid())
  name                    String
  category                ProductCategory?
  categoryId              String?
  brand                   String?
  description             String?
  mrp                     Decimal?         @db.Decimal(10, 2)
  price                   Decimal          @db.Decimal(10, 2)
  discountPercent         Decimal?         @db.Decimal(5, 2)
  vendorWholesalePrice    Decimal?         @db.Decimal(10, 2)
  bulkMinQty              Int              @default(1)
  bulkDiscountPercent     Decimal?         @db.Decimal(5, 2)
  referralDiscountPercent Decimal?         @db.Decimal(5, 2)
  isPartOnlyForVendor     Boolean          @default(false)
  pv                      Decimal          @default(0) @db.Decimal(10, 2)
  bv                      Decimal          @default(0) @db.Decimal(10, 2)
  bulkQtyDiscount         Boolean          @default(false)
  stock                   Int              @default(0)
  images                  String[]         @default([])
  specifications          Json?
  features                String[]         @default([])
  rating                  Float            @default(0)
  ratingCount             Int              @default(0)
  isActive                Boolean          @default(true)
  addedByVendorId         String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  dynamicCategory Category?        @relation("ProductCategoryRelation", fields: [categoryId], references: [id])
  addedByVendor   VendorProfile?   @relation("VendorAddedProducts", fields: [addedByVendorId], references: [id])
  branch          Branch?          @relation(fields: [branchId], references: [id])
  orderItems      OrderItem[]
  cartItems       CartItem[]
  leads           Lead[]
  inventory       Inventory?
  reviews         ProductReview[]
}

/**
 * ─────────────────────────────
 * PRODUCT REVIEW
 * ──────────────────────────────
 */
model ProductReview {
  id               String   @id @default(uuid())
  productId        String
  userId           String
  rating           Int      // 1 to 5
  title            String?
  comment          String?
  images           String[] @default([])
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation("UserProductReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, rating])
}

/**
 * ─────────────────────────────
 * SERVICE CATALOG
 * ──────────────────────────────
 */
model Service {
  branchId    String?
  id          String           @id @default(uuid())
  name        String
  category    ServiceCategory?
  categoryId  String?
  description String?
  price       Decimal          @db.Decimal(10, 2)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  dynamicCategory Category?        @relation("ServiceCategoryRelation", fields: [categoryId], references: [id])
  serviceRequests ServiceRequest[]
  branch          Branch?          @relation(fields: [branchId], references: [id])
  leads           Lead[]
}

/**
 * ─────────────────────────────
 * LEAD MANAGEMENT
 * ──────────────────────────────
 */
model Lead {
  branchId             String?
  id                   String     @id @default(uuid())
  customerName         String
  phone                String
  email                String?
  address              String?
  district             String?
  pincode              String?
  specialization       String?
  latitude             Float?
  longitude            Float?
  area                 String? // shown to technician pre-accept, in place of exact address
  issue                String?
  serviceType          String?
  estimatedAmount      Decimal?   @db.Decimal(10, 2)
  leadPrice            Decimal?   @db.Decimal(10, 2)
  leadAcceptPrice      Decimal?   @db.Decimal(10, 2)
  leadAcceptanceCharge Decimal?   @db.Decimal(10, 2) // coins deducted on accept (snapshot of config at accept time)
  isReleased           Boolean    @default(false)
  releasedAt           DateTime?
  leadCreatedByType    String?    @default("CUSTOMER")

  source               LeadSource @default(ALL)
  status               LeadStatus @default(NEW)
  productId            String?
  serviceId            String?
  serviceRequestId     String?    @unique
  assignedToId         String? // legacy: user/MR the lead is assigned to
  assignedVendorId     String? // current: vendor/technician the lead is assigned to
  createdById          String? // user/admin/panel that created the lead
  verifiedBySuperAdmin Boolean    @default(false)
  notes                String?

  acceptedAt      DateTime?
  startVerifiedAt DateTime?
  completedAt     DateTime?
  deniedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product?        @relation(fields: [productId], references: [id])
  service        Service?        @relation(fields: [serviceId], references: [id])
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  assignedTo     User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  assignedVendor Vendor?         @relation("LeadAssignments", fields: [assignedVendorId], references: [id])
  createdBy      User?           @relation("LeadCreatedBy", fields: [createdById], references: [id])

  assignmentHistory LeadAssignment[]
  visitProofs       LeadVisitProof[]
  denialProofs      LeadDenialProof[]
  progressLogs      LeadProgress[]
  commission        Commission?
  payments          Payment[]
  review            Review?
  branch            Branch?           @relation(fields: [branchId], references: [id])
}

/**
 * Assignment/acceptance history — kept separate from Lead so re-assignment
 * (e.g. after a rejection) doesn't lose the trail.
 */
model LeadAssignment {
  id         String    @id @default(uuid())
  leadId     String
  vendorId   String
  acceptedAt DateTime  @default(now())
  rejectedAt DateTime?

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([leadId])
  @@index([vendorId])
}

/**
 * Proof captured when technician presses "Start Work" — GPS + image,
 * held as PENDING_START_VERIFICATION until admin verifies.
 */
model LeadVisitProof {
  id         String    @id @default(uuid())
  leadId     String
  vendorId   String
  latitude   Float
  longitude  Float
  accuracy   Float?
  image      String
  capturedAt DateTime
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])
}

/**
 * Proof captured when technician cannot complete the service — image +
 * reason + GPS, held as PENDING_DENIAL_VERIFICATION until admin verifies.
 */
model LeadDenialProof {
  id         String    @id @default(uuid())
  leadId     String
  vendorId   String
  reason     String
  image      String
  latitude   Float
  longitude  Float
  capturedAt DateTime
  approved   Boolean?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])
}

/**
 * Free-form progress logs while a lead is ONGOING — images/notes/parts used.
 */
model LeadProgress {
  id        String   @id @default(uuid())
  leadId    String
  vendorId  String
  note      String?
  images    String[] @default([])
  partsUsed String[] @default([])
  createdAt DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([leadId, createdAt])
}

/**
 * ─────────────────────────────
 * ORDERS
 * ──────────────────────────────
 */
model Cart {
  id        String     @id @default(uuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation("UserCarts", fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  branchId        String?
  id              String        @id @default(uuid())
  customerId      String
  vendorId        String? // legacy VendorProfile handling the order
  assignedVendorId String? // current standalone Vendor handling the order
  type            OrderType     @default(PRODUCT)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  deliveryAddress String?
  completionPhoto String? // proof photo captured on completion
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer User           @relation("OrderCustomer", fields: [customerId], references: [id])
  vendor   VendorProfile? @relation("VendorOrders", fields: [vendorId], references: [id])
  items    OrderItem[]
  payments Payment[]
  branch   Branch?        @relation(fields: [branchId], references: [id])
  assignedVendor Vendor? @relation("OrderAssignedVendor", fields: [assignedVendorId], references: [id])
  mlmCommissions MlmCommission[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

/**
 * ─────────────────────────────
 * SERVICE REQUESTS (installation / repair / AMC)
 * ──────────────────────────────
 */
model ServiceRequest {
  branchId         String?
  id               String               @id @default(uuid())
  customerId       String
  vendorId         String? // legacy VendorProfile assignment
  assignedVendorId String?
  serviceId        String
  status           ServiceRequestStatus @default(NEW)
  priority         Int                  @default(0)
  scheduledAt      DateTime?
  acceptedAt       DateTime?
  completedAt      DateTime?
  deniedAt         DateTime?
  cancelledAt      DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  customer       User           @relation("ServiceRequestCustomer", fields: [customerId], references: [id])
  vendor         VendorProfile? @relation("VendorServiceRequests", fields: [vendorId], references: [id])
  assignedVendor Vendor?        @relation("ServiceRequestAssignedVendor", fields: [assignedVendorId], references: [id])
  service        Service        @relation(fields: [serviceId], references: [id])
  payments       Payment[]
  branch         Branch?        @relation(fields: [branchId], references: [id])
  lead           Lead?          @relation

  @@index([customerId, createdAt])
  @@index([assignedVendorId, status])
}

/**
 * ─────────────────────────────
 * PAYMENTS
 * ──────────────────────────────
 */
model Payment {
  id               String        @id @default(uuid())
  orderId          String?
  serviceRequestId String?
  leadId           String? // lead-completion QR payment
  vendorId         String?
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  transactionId    String?       @unique
  qrPayload        String? // demo QR payload; replaced by Razorpay order id later
  reviewToken      String?       @unique // given to the client on completion; required to submit a Review
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order          Order?          @relation(fields: [orderId], references: [id])
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  lead           Lead?           @relation(fields: [leadId], references: [id])
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
}

/**
 * ─────────────────────────────
 * COMMISSION (flat, phase 1 — referral fields exist on Vendor for a
 * future multi-level engine, but no MLM logic is implemented yet)
 * ──────────────────────────────
 */
model Commission {
  id            String           @id @default(uuid())
  leadId        String           @unique
  vendorId      String
  amount        Decimal          @db.Decimal(10, 2)
  percentage    Decimal          @db.Decimal(5, 2)
  transactionId String?
  status        CommissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lead   Lead   @relation(fields: [leadId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])
}

/**
 * ─────────────────────────────
 * MLM COMMISSION & WITHDRAWALS
 * ──────────────────────────────
 */
model MlmCommission {
  id             String            @id @default(uuid())
  userId         String?
  vendorId       String?
  orderId        String?
  level          Int               @default(1)
  percentage     Decimal           @db.Decimal(5, 2)
  commissionType MlmCommissionType @default(LEVEL_BONUS)
  amount         Decimal           @db.Decimal(12, 2)
  bv             Decimal           @default(0) @db.Decimal(12, 2)
  status         CommissionStatus  @default(CREDITED)
  createdAt      DateTime          @default(now())

  user   User?   @relation("UserMlmCommissions", fields: [userId], references: [id])
  vendor Vendor? @relation("VendorMlmCommissions", fields: [vendorId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@index([vendorId, createdAt])
  @@index([orderId])
}

model WithdrawalRequest {
  id             String           @id @default(uuid())
  userId         String?
  vendorId       String?
  amount         Decimal          @db.Decimal(12, 2)
  bankAccount    String?
  ifsc           String?
  upiId          String?
  status         WithdrawalStatus @default(PENDING)
  adminNote      String?
  transactionRef String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user   User?   @relation("UserWithdrawals", fields: [userId], references: [id])
  vendor Vendor? @relation("VendorWithdrawals", fields: [vendorId], references: [id])

  @@index([userId, status])
  @@index([vendorId, status])
}

/**
 * ─────────────────────────────
 * VENDOR COMPLAINTS (distinct from the client-facing Complaint model)
 * ──────────────────────────────
 */
model VendorComplaint {
  id          String                  @id @default(uuid())
  vendorId    String
  category    VendorComplaintCategory
  subject     String
  description String
  status      VendorComplaintStatus   @default(OPEN)
  adminReply  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])
}

/**
 * ─────────────────────────────
 * OFFERS (skeleton — reward catalog + per-vendor reward history)
 * ──────────────────────────────
 */
model Offer {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        OfferType
  value       Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rewards OfferReward[]
}

model OfferReward {
  id         String    @id @default(uuid())
  offerId    String
  vendorId   String
  grantedAt  DateTime  @default(now())
  redeemedAt DateTime?

  offer  Offer  @relation(fields: [offerId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])
}

/**
 * ─────────────────────────────
 * PARTS (skeleton — spare parts catalog, mirrors Product)
 * ──────────────────────────────
 */
model Part {
  id          String     @id @default(uuid())
  name        String
  description String?
  price       Decimal    @db.Decimal(10, 2)
  stock       Int        @default(0)
  images      String[]   @default([])
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  inventory   Inventory?
}

/**
 * ─────────────────────────────
 * COMPLAINTS / SUPPORT
 * ──────────────────────────────
 */
model Complaint {
  id          String          @id @default(uuid())
  userId      String
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  resolvedBy  String?
  adminReply  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation("UserComplaints", fields: [userId], references: [id])
}

/**
 * ─────────────────────────────
 * OTP MODEL
 * ──────────────────────────────
 */
model OtpCode {
  id         String   @id @default(cuid())
  identifier String
  purpose    String   @default("VERIFY") // SIGNUP | LOGIN | RESET_PASSWORD | VERIFY
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
}

/**
 * ─────────────────────────────
 * BLACKLISTED TOKEN MODEL
 * ──────────────────────────────
 */
model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/**
 * ─────────────────────────────
 * NOTIFICATION SYSTEM
 * ──────────────────────────────
 */
model Notification {
  id        String   @id @default(uuid())
  userId    String?
  vendorId  String?
  title     String
  message   String
  type      String   @default("Info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User?   @relation("UserNotifications", fields: [userId], references: [id])
  vendor Vendor? @relation("VendorNotifications", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([vendorId, createdAt])
}

/**
 * ─────────────────────────────
 * SYSTEM SETTINGS (SUPER ADMIN ONLY)
 * ──────────────────────────────
 */
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * ─────────────────────────────
 * ACTIVITY LOG
 * ──────────────────────────────
 */
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

/**
 * ─────────────────────────────
 * GENERAL SITE FEEDBACK
 * ──────────────────────────────
 */
model SiteFeedback {
  id        String             @id @default(uuid())
  userId    String
  type      SiteFeedbackType
  title     String
  message   String
  rating    Int?
  status    SiteFeedbackStatus @default(PENDING)
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation("UserSiteFeedbacks", fields: [userId], references: [id])
}

/**
 * ─────────────────────────────
 * CHAT (customer <-> vendor / support)
 * ──────────────────────────────
 */
model ChatRoom {
  id        String   @id @default(uuid())
  type      ChatType @default(DIRECT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatRoomMember[]
  messages Message[]
}

model ChatRoomMember {
  id         String    @id @default(uuid())
  chatRoomId String
  userId     String?
  vendorId   String?
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User?    @relation("UserChatRooms", fields: [userId], references: [id], onDelete: Cascade)
  vendor   Vendor?  @relation("VendorChatRooms", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId], name: "UniqueChatUserMember")
  @@unique([chatRoomId, vendorId], name: "UniqueChatVendorMember")
}

model Message {
  id           String      @id @default(uuid())
  chatRoomId   String
  senderId     String?
  senderVendorId String?
  type         MessageType @default(TEXT)
  content      String?
  fileUrl      String?
  fileName     String?
  fileMimeType String?
  duration     Int?
  isEdited     Boolean     @default(false)
  isDeleted    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  chatRoom ChatRoom      @relation(fields: [chatRoomId], references: [id])
  sender       User?   @relation("UserMessages", fields: [senderId], references: [id])
  senderVendor Vendor? @relation("VendorMessages", fields: [senderVendorId], references: [id])
  readBy   MessageRead[]
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id])
  user    User    @relation("UserMessageReads", fields: [userId], references: [id])

  @@unique([messageId, userId])
}

/**
 * ─────────────────────────────
 * AI CHATBOT / SUPPORT ASSISTANT
 * ──────────────────────────────
 */
model ChatbotSession {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatbotMessage[]

  @@index([userId, updatedAt])
}

model ChatbotMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String // "user" | "bot"
  content   String
  createdAt DateTime @default(now())

  session ChatbotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/**
 * ─────────────────────────────
 * PHASE 2 CUSTOMER / PLATFORM MODELS
 * ──────────────────────────────
 */
model Customer {
  id            String   @id @default(uuid())
  userId        String   @unique
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
}

model PaymentWebhook {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @unique
  signature   String?
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, createdAt])
}

model WalletIssue {
  id          String                @id @default(uuid())
  vendorId    String
  subject     String
  description String
  status      VendorComplaintStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String // PERCENT | FIXED
  discountValue  Decimal   @db.Decimal(10, 2)
  maxDiscount    Decimal?  @db.Decimal(10, 2)
  minOrderAmount Decimal?  @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, expiresAt])
}

model Voucher {
  id         String    @id @default(uuid())
  code       String    @unique
  title      String
  amount     Decimal   @db.Decimal(10, 2)
  expiresAt  DateTime?
  isRedeemed Boolean   @default(false)
  redeemedAt DateTime?
  customerId String?
  createdAt  DateTime  @default(now())

  @@index([customerId, isRedeemed])
}

model Inventory {
  id           String   @id @default(uuid())
  productId    String?  @unique
  partId       String?  @unique
  branchId     String?
  quantity     Int      @default(0)
  reserved     Int      @default(0)
  reorderLevel Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id])
  part    Part?    @relation(fields: [partId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id])

  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id          String   @id @default(uuid())
  inventoryId String
  type        String // IN | OUT | ADJUSTMENT | RESERVE | RELEASE
  quantity    Int
  referenceId String?
  note        String?
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorType, actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}
